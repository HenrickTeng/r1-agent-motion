[Unit]
Description=R1 deterministic robot gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=r1-gateway
Group=r1-gateway
EnvironmentFile=/etc/r1-gateway/environment
ExecStart=/opt/r1-gateway/bin/r1-gateway --listen 192.168.123.164:50051 --tls-dir /etc/r1-gateway/tls
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/r1-gateway /var/log/r1-gateway

[Install]
WantedBy=multi-user.target
