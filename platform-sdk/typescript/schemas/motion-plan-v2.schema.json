{
  "$defs": {
    "ActionStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Action",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "type": {
          "const": "action",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "action"
      ],
      "title": "ActionStep",
      "type": "object"
    },
    "MoveForStep": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Duration S",
          "type": "number"
        },
        "type": {
          "const": "move_for",
          "title": "Type",
          "type": "string"
        },
        "vx_mps": {
          "maximum": 0.15,
          "minimum": -0.15,
          "title": "Vx Mps",
          "type": "number"
        },
        "vy_mps": {
          "maximum": 0.1,
          "minimum": -0.1,
          "title": "Vy Mps",
          "type": "number"
        }
      },
      "required": [
        "type",
        "vx_mps",
        "vy_mps",
        "duration_s"
      ],
      "title": "MoveForStep",
      "type": "object"
    },
    "SayStep": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "say",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "SayStep",
      "type": "object"
    },
    "TurnRelativeStep": {
      "additionalProperties": false,
      "properties": {
        "angle_deg": {
          "maximum": 30,
          "minimum": -30,
          "title": "Angle Deg",
          "type": "number"
        },
        "type": {
          "const": "turn_relative",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "angle_deg"
      ],
      "title": "TurnRelativeStep",
      "type": "object"
    },
    "WaitStep": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "maximum": 10,
          "minimum": 0.1,
          "title": "Duration S",
          "type": "number"
        },
        "type": {
          "const": "wait",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "duration_s"
      ],
      "title": "WaitStep",
      "type": "object"
    }
  },
  "$id": "https://r1-motion.local/schemas/motion-plan-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$",
      "title": "Plan Id",
      "type": "string"
    },
    "require_operator_enable": {
      "const": true,
      "default": true,
      "title": "Require Operator Enable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "motion-plan/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "action": "#/$defs/ActionStep",
            "move_for": "#/$defs/MoveForStep",
            "say": "#/$defs/SayStep",
            "turn_relative": "#/$defs/TurnRelativeStep",
            "wait": "#/$defs/WaitStep"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SayStep"
          },
          {
            "$ref": "#/$defs/ActionStep"
          },
          {
            "$ref": "#/$defs/MoveForStep"
          },
          {
            "$ref": "#/$defs/TurnRelativeStep"
          },
          {
            "$ref": "#/$defs/WaitStep"
          }
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "steps"
  ],
  "title": "MotionPlan",
  "type": "object"
}
