{
  "$defs": {
    "LimitSummary": {
      "additionalProperties": false,
      "properties": {
        "maximum_abs_offset_rad": {
          "minimum": 0,
          "title": "Maximum Abs Offset Rad",
          "type": "number"
        },
        "maximum_acceleration_rad_s2": {
          "minimum": 0,
          "title": "Maximum Acceleration Rad S2",
          "type": "number"
        },
        "maximum_jerk_rad_s3": {
          "minimum": 0,
          "title": "Maximum Jerk Rad S3",
          "type": "number"
        },
        "maximum_speed_rad_s": {
          "minimum": 0,
          "title": "Maximum Speed Rad S",
          "type": "number"
        },
        "return_error_rad": {
          "minimum": 0,
          "title": "Return Error Rad",
          "type": "number"
        }
      },
      "required": [
        "maximum_abs_offset_rad",
        "maximum_speed_rad_s",
        "maximum_acceleration_rad_s2",
        "maximum_jerk_rad_s3",
        "return_error_rad"
      ],
      "title": "LimitSummary",
      "type": "object"
    },
    "TrajectorySample": {
      "additionalProperties": false,
      "properties": {
        "position_rad": {
          "items": {
            "type": "number"
          },
          "title": "Position Rad",
          "type": "array"
        },
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "velocity_rad_s": {
          "items": {
            "type": "number"
          },
          "title": "Velocity Rad S",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "position_rad",
        "velocity_rad_s"
      ],
      "title": "TrajectorySample",
      "type": "object"
    }
  },
  "$id": "https://r1-motion.local/schemas/compiled-trajectory-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiler_version": {
      "title": "Compiler Version",
      "type": "string"
    },
    "coordinate_mode": {
      "const": "relative_current",
      "default": "relative_current",
      "title": "Coordinate Mode",
      "type": "string"
    },
    "joint_order": {
      "items": {
        "enum": [
          "left_shoulder_pitch",
          "left_shoulder_roll",
          "left_shoulder_yaw",
          "left_elbow",
          "left_wrist_roll",
          "right_shoulder_pitch",
          "right_shoulder_roll",
          "right_shoulder_yaw",
          "right_elbow",
          "right_wrist_roll",
          "waist_yaw",
          "head_pitch",
          "head_yaw"
        ],
        "type": "string"
      },
      "title": "Joint Order",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/LimitSummary"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "safety_profile_version": {
      "title": "Safety Profile Version",
      "type": "string"
    },
    "sample_hz": {
      "const": 100,
      "default": 100,
      "title": "Sample Hz",
      "type": "integer"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/TrajectorySample"
      },
      "minItems": 2,
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": "compiled-trajectory/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trajectory_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Trajectory Id",
      "type": "string"
    },
    "trajectory_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Trajectory Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trajectory_id",
    "joint_order",
    "samples",
    "limits",
    "compiler_version",
    "model_version",
    "safety_profile_version",
    "trajectory_sha256"
  ],
  "title": "CompiledTrajectory",
  "type": "object"
}
